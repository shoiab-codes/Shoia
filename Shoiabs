<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shoaib's Website</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            text-align: center;
            background-color: #f4f4f4;
        }
        header {
            background-color: #333;
            color: white;
            padding: 20px;
            font-size: 24px;
            font-weight: bold;
        }
        main {
            padding: 20px;
        }
        img {photojpg
            width: 200px; /* Adjust size as needed */
            height: 200px;
            border-radius: 50%; /* Makes the image circular */
            margin-top: 20px;
            border: 3px solid #333;
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            background-color: #008CBA;
            color: white;
            border: none;
            cursor: pointer;
            margin-top: 20px;
        }
        button:hover {
            background-color: #005f73;
        }
    </style>
</head>
<body>

    <header>Shoaib</header>

    <main>
        <h1>Welcome to My Website</h1>
        <p>This is a simple webpage designed for practice.</p>

        <!-- Add your photo here -->
        <img src="photo.jpg" alt="Shoaib's Photo">

        <br>
        <button onclick="showMessage()">Click Me</button>
    </main>

    <script>
        function showMessage() {
            alert("Hello, Shoaib! Welcome to your website.");
        }
    </script>

</body>
</html>
